--- !u!114 &1104096837910184946
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1993027512925448991}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e32f929151a849845aa30dd88233a25b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::HeroAbilityTreeUI
  botones:
  - {fileID: 2429984290013760982}
  - {fileID: 5912937616652206987}
  - {fileID: 1096085356069580230}
  - {fileID: 8726299450427255023}
  - {fileID: 0}
  - {fileID: 0}
  nodos:
  - nombre: Muro de Basalto
    elemento: Tierra
    costo: 3
    moneda: Cristales de Voto
    descripcion: "Caelen arranca una losa de basalto del suelo y la clava frente
      a \xE9l. Bloquea el paso, sirve de trinchera contra r\xE1fagas y es la \xFAnica
      forma de energizar las placas tel\xFAricas de presi\xF3n."
    colorNodo: {r: 0.55, g: 0.42, b: 0.22, a: 1}
  - nombre: Piel de Roca
    elemento: Tierra
    costo: 5
    moneda: Oro Puro
    descripcion: "Endurece la piel de Caelen: reduce el da\xF1o recibido un 25% durante
      6 segundos. Sinergia con Muro de Basalto al sostener una posici\xF3n sellada."
    colorNodo: {r: 0.62, g: 0.48, b: 0.26, a: 1}
  - nombre: "Ra\xEDces Voraces"
    elemento: Madera
    costo: 3
    moneda: Cristales de Voto
    descripcion: "Illya hace brotar ra\xEDces en un \xE1rea de 3 metros que golpean
      a todo enemigo cercano y aplican retroceso. Ideal para limpiar enjambres de
      Fauna Corrupta."
    colorNodo: {r: 0.16, g: 0.55, b: 0.34, a: 1}
  - nombre: Pulso de Savia
    elemento: Madera
    costo: 5
    moneda: Esencias Elementales
    descripcion: "Illya canaliza savia viva y sana un 20% de la vitalidad del h\xE9roe
      activo. Puede usarse durante el relevo para sostener al compa\xF1ero."
    colorNodo: {r: 0.2, g: 0.62, b: 0.4, a: 1}
  - nombre: "Sinergia Tel\xFArica"
    elemento: Pasiva
    costo: 8
    moneda: Cristales de Voto
    descripcion: "Los golpes de Caelen sobre un enemigo aturdido por Ra\xEDces Voraces
      infligen un 30% de da\xF1o adicional. Refuerza el ciclo Tag-Team entre Tierra
      y Madera."
    colorNodo: {r: 0.34, g: 0.3, b: 0.52, a: 1}
  - nombre: "V\xEDnculo de Savia"
    elemento: Pasiva
    costo: 8
    moneda: Oro Puro
    descripcion: "Al cambiar de h\xE9roe, el h\xE9roe entrante recibe un escudo equivalente
      al 10% de la vida del h\xE9roe saliente. Premia el relevo bien cronometrado."
    colorNodo: {r: 0.22, g: 0.46, b: 0.5, a: 1}
  textoNombre: {fileID: 9087914676547243122}
  textoCosto: {fileID: 5766326427024933184}
  textoDescripcion: {fileID: 8996678579961110801}
