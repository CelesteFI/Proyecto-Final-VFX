  m_Script: {fileID: 11500000, guid: 4f516e6821efeaa4b8e1b958dd12cba3, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ResourceCodexUI
  tarjetas:
  - {fileID: 1639492880490465684}
  - {fileID: 5358695695547644508}
  - {fileID: 4999390235816734145}
  fichas:
  - titulo: Oro Puro
    categoria: Metal de forja
    cantidad: 3
    descripcionUso: "Se funde en los altares de forja para reforzar el equipo de
      Caelen y anclar engranajes r\xFAnicos."
    lore: "\"El oro que no se dobla no sirve para una era que se rompe.\" \u2014
      Grabado del \xC1rbol Sombr\xEDo"
    colorFicha: {r: 0.83, g: 0.62, b: 0.18, a: 1}
  - titulo: Cristales de Voto
    categoria: Reliquia de juramento
    cantidad: 5
    descripcionUso: "Desbloquean nodos del \xE1rbol de habilidades elementales de
      ambos h\xE9roes."
    lore: "\"Cada voto dej\xF3 un cristal. Cada cristal recuerda una promesa incumplida.\"
      \u2014 Mural del Templo Central"
    colorFicha: {r: 0.36, g: 0.55, b: 0.9, a: 1}
  - titulo: Esencias Elementales
    categoria: Esencia de relieve
    cantidad: 2
    descripcionUso: 'Nutren habilidades avanzadas: las de Tierra provienen de la
      roca viva; las de Madera, de la savia profunda.'
    lore: "\"Ecos de una era olvidada: la piedra y la savia a\xFAn recuerdan qui\xE9n
      las despert\xF3.\""
